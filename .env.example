# ---------------------------------------------------------------------------
# Supabase  (Dashboard > Project Settings > API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# NUNCA exponha esta chave no browser. Usada apenas em rotas de servidor e scripts.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Senha do banco (usada pela CLI do Supabase em `supabase db push`)
SUPABASE_DB_PASSWORD=""

# ---------------------------------------------------------------------------
# Google Gemini  (https://aistudio.google.com/apikey)
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza..."

# Modelos usados pela plataforma.
# Rode `npm run models` para ver o que a SUA chave alcanca — o catalogo do
# Google muda e modelos antigos deixam de ser liberados para contas novas.
# Os modelos Pro exigem billing habilitado; no free tier eles retornam 429.
#
# O Gemini NAO redige as licoes nem gera audio: o curso inteiro esta escrito
# em content/circuits/ e a fala e sintetizada no navegador. A IA aqui so faz
# o que exige inteligencia — ouvir o aluno, conversar ao vivo, tirar duvida
# e indexar o material.
GEMINI_MODEL_TUTOR="gemini-3.1-flash-lite"
GEMINI_MODEL_SPEAKING="gemini-3.6-flash"
GEMINI_MODEL_EMBEDDING="gemini-embedding-001"
GEMINI_MODEL_LIVE="gemini-3.1-flash-live-preview"

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dominio que vai dentro do QR Code dos certificados e nos links de
# autenticidade. Deixe em branco para usar o NEXT_PUBLIC_SITE_URL acima.
#
# Preencha com o dominio de PRODUCAO mesmo em desenvolvimento: um certificado
# com QR apontando para localhost nao abre no celular de ninguem. Trocou de
# dominio? Basta mudar aqui — nada mais no codigo precisa ser alterado.
NEXT_PUBLIC_CERTIFICATE_BASE_URL="https://seu-dominio.com.br"

# E-mails que recebem papel de administrador automaticamente no primeiro login.
# Separe por virgula.
ADMIN_BOOTSTRAP_EMAILS="voce@exemplo.com"

# ---------------------------------------------------------------------------
# Mercado Pago  (https://www.mercadopago.com.br/developers/panel)
#
# E a API de pagamentos do Mercado Livre: mesma conta, mesmo login. O dinheiro
# cai na conta Mercado Pago dona do token abaixo.
#
# COMO OBTER:
#   1. Painel do desenvolvedor > Suas integracoes > criar/abrir a aplicacao
#   2. Credenciais de producao > Access token   (comeca com APP_USR-)
#      Para testar sem mover dinheiro use o token de teste (comeca com TEST-).
#
# NUNCA exponha este token no browser: com ele da para ler e estornar
# pagamentos da conta inteira.
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Assinatura secreta do webhook.
#   Painel > Suas integracoes > Webhooks > Configurar notificacoes
#   URL de producao: https://SEU-DOMINIO/api/pagamentos/webhook
#   Evento: "Pagamentos"
#
# Sem este segredo, qualquer um que descubra a URL manda um POST dizendo
# "aprovado" e ganha o curso. Em producao a aplicacao RECUSA webhook sem
# assinatura valida.
MERCADOPAGO_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Checkout — preco do acesso ao curso
#
# Em CENTAVOS: 29700 = R$ 297,00. O parcelamento sai com juros por conta do
# comprador (padrao do Mercado Pago), entao voce recebe o valor cheio.
# ---------------------------------------------------------------------------
CHECKOUT_PRICE_CENTS="29700"
CHECKOUT_MAX_INSTALLMENTS="10"
CHECKOUT_PRODUCT_TITLE="Easy English — Acesso completo ao curso"
# Como aparece na fatura do cartao (max. 13 caracteres).
CHECKOUT_STATEMENT_DESCRIPTOR="EASYENGLISH"
# Prazo para concluir o pagamento antes de o link expirar.
CHECKOUT_EXPIRATION_HOURS="48"

# ---------------------------------------------------------------------------
# Google Cloud Text-to-Speech (vozes Neural2) — SO PARA GERAR AUDIO
#
# Nao vai para o servidor: o app em producao serve MP3 estatico de
# public/audio/. Isto e so para `npm run gen:audio -- --engine google`.
#
# O Cloud TTS RECUSA chave de API ("API keys are not supported by this API"),
# entao a GEMINI_API_KEY nao serve aqui. Precisa de conta de servico:
#
#   1. console.cloud.google.com -> projeto
#   2. Ative a "Cloud Text-to-Speech API"
#   3. IAM -> Contas de servico -> criar -> Chaves -> JSON -> baixar
#   4. Guarde o JSON FORA do repositorio e aponte o caminho abaixo
#
# O arquivo e uma credencial de verdade: nunca versione, nunca cole em chat.
# ---------------------------------------------------------------------------
GOOGLE_TTS_CREDENTIALS="C:/caminho/para/conta-de-servico.json"
