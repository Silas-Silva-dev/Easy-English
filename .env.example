# ---------------------------------------------------------------------------
# Supabase  (Dashboard > Project Settings > API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# NUNCA exponha esta chave no browser. Usada apenas em rotas de servidor e scripts.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Senha do banco (usada pela CLI do Supabase em `supabase db push`)
SUPABASE_DB_PASSWORD=""

# ---------------------------------------------------------------------------
# Google Gemini  (https://aistudio.google.com/apikey)
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza..."

# Modelos usados pela plataforma.
# Rode `npm run models` para ver o que a SUA chave alcanca — o catalogo do
# Google muda e modelos antigos deixam de ser liberados para contas novas.
# Os modelos Pro exigem billing habilitado; no free tier eles retornam 429.
#
# O Gemini NAO redige as licoes nem gera audio: o curso inteiro esta escrito
# em content/circuits/ e a fala e sintetizada no navegador. A IA aqui so faz
# o que exige inteligencia — ouvir o aluno, conversar ao vivo, tirar duvida
# e indexar o material.
GEMINI_MODEL_TUTOR="gemini-3.6-flash"
GEMINI_MODEL_SPEAKING="gemini-3.6-flash"
GEMINI_MODEL_EMBEDDING="gemini-embedding-001"
GEMINI_MODEL_LIVE="gemini-3.1-flash-live-preview"

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E-mails que recebem papel de administrador automaticamente no primeiro login.
# Separe por virgula.
ADMIN_BOOTSTRAP_EMAILS="voce@exemplo.com"
