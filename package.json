{
  "name": "easy-english",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de cursos online com painel administrativo e tutor de conversacao em ingles com IA (Gemini).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:bundle": "tsx scripts/bundle-schema.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "check": "tsx scripts/check-setup.ts",
    "check:email": "tsx scripts/check-email.ts",
    "check:audio": "tsx scripts/check-audio.ts",
    "compare:fala": "tsx --conditions=react-server scripts/compare-speaking-models.ts",
    "check:pagamento": "tsx scripts/check-payments.ts",
    "check:seguranca": "tsx scripts/check-security.ts",
    "check:qr": "tsx scripts/check-qr.ts",
    "models": "tsx scripts/list-models.ts",
    "gen:icons": "tsx scripts/generate-icons.ts",
    "gen:audio": "tsx scripts/generate-audio.ts",
    "rebuild:audio": "tsx scripts/rebuild-native-audio.ts",
    "gen:audio:setup": "pip install piper-tts && python -m piper.download_voices en_US-amy-medium en_US-ryan-medium en_US-lessac-medium en_US-joe-medium en_US-kristin-medium en_US-hfc_male-medium --download-dir .piper-voices",
    "gen:listening": "tsx scripts/generate-listening.ts",
    "verify:content": "tsx scripts/verify-content.ts",
    "cleanup:audio": "tsx scripts/cleanup-audio.ts",
    "seed:curriculum": "tsx scripts/seed-curriculum.ts",
    "index:knowledge": "tsx scripts/index-knowledge.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "gen:pronuncia": "tsx scripts/generate-pronunciation.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
